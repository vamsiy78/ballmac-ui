{
  "name": "@ballmac/mcp",
  "version": "1.0.1",
  "description": "MCP server for Ballmac UI: search, inspect and install Ballmac UI components, blocks and templates, and compose pages from them.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "shadcn",
    "shadcn-ui",
    "react",
    "tailwindcss",
    "components",
    "ui",
    "ai",
    "claude",
    "cursor"
  ],
  "type": "module",
  "license": "MIT",
  "author": "Ballmac <https://ui.ballmac.com>",
  "homepage": "https://ui.ballmac.com/docs/mcp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vamsiy78/ballmac-ui.git",
    "directory": "packages/mcp"
  },
  "bugs": {
    "url": "https://github.com/vamsiy78/ballmac-ui/issues"
  },
  "bin": {
    "ballmac-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json && chmod +x dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node test/e2e.mjs",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^20",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
