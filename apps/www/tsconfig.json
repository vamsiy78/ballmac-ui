{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/components/ballmac/*": [
        "../../registry/ballmac/components/*"
      ],
      "@/hooks/ballmac/*": [
        "../../registry/ballmac/hooks/*"
      ],
      "@/lib/ballmac/*": [
        "../../registry/ballmac/lib/*"
      ],
      "@/registry/*": [
        "../../registry/*"
      ],
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    "../../registry/**/*.tsx",
    "../../registry/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
