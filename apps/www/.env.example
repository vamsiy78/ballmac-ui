# Ballmac UI Pro licence checks. Pick one provider.
BALLMAC_LICENSE_PROVIDER=          # lemonsqueezy | polar | dodopayments
LEMONSQUEEZY_STORE_ID=             # optional: only accept keys from this store
LEMONSQUEEZY_PRODUCT_IDS=          # optional: comma-separated product IDs that unlock Pro
POLAR_ORGANIZATION_ID=             # required for polar
POLAR_BENEFIT_IDS=                 # optional: comma-separated licence-key benefit IDs that unlock Pro
DODO_MODE=                         # dodopayments: "test" for test mode, empty for live
DODO_PRODUCT_IDS=                  # dodopayments, optional: product ids that unlock Pro (needs the validate answer to name the product; check with pnpm launch:check --live --key <key>)

# Development and testing only: keys that always count as valid. Leave empty in production.
BALLMAC_PRO_TEST_KEYS=

# Checkout links shown on the pricing page. When empty, the page shows "coming soon".
NEXT_PUBLIC_PRO_CHECKOUT_URL=
NEXT_PUBLIC_PRO_TEAM_CHECKOUT_URL=
NEXT_PUBLIC_PRO_PRICE=
NEXT_PUBLIC_PRO_TEAM_PRICE=
# Link to the published Pro licence terms (written by the owner or a lawyer). Required for production.
NEXT_PUBLIC_PRO_LICENSE_URL=

# Production builds clone the private Pro source (see LAUNCH.md). Set these in Vercel / CI only, never commit them.
PRO_REPO_TOKEN=                    # fine-grained token, read-only Contents on the Pro repo
PRO_REPO=vamsiy78/ballmac-ui-pro   # optional override
PRO_REPO_REF=                      # optional: branch, tag or sha (default main in production, preprod otherwise)
BALLMAC_REQUIRE_PRO=               # set to 1 to fail the build when Pro cannot be fetched (always on for Vercel production)
