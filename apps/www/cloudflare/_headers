# Response headers for the static files on Cloudflare (copied into out/ by worker/postbuild.ts). The Worker sets its own for the routes it answers.
# Keep in step with headers() in next.config.ts, which applies them in development.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy: frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Permissions-Policy: camera=(self), microphone=(self), geolocation=(), payment=(), usb=(), interest-cohort=()

# Free registry items: public, cacheable, and fetchable cross-origin by the shadcn CLI and v0. (/r/pro/* never reaches this file: the Worker answers it.)
/r/*
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=0, s-maxage=3600, stale-while-revalidate=86400

# The public catalogue API (CLI and MCP).
/api/v1/*
  Access-Control-Allow-Origin: *

/license/pro/text
  Content-Type: text/plain; charset=utf-8

/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Social share images have no file extension in the build, so their type is set here.
/opengraph-image
  Content-Type: image/png
/components/:slug/opengraph-image-*
  Content-Type: image/png
/blocks/:slug/opengraph-image-*
  Content-Type: image/png
/templates/:slug/opengraph-image-*
  Content-Type: image/png

# Feeds and the Markdown copies of the docs. The Markdown is for readers and agents, so it stays out of search results (the pages carry the same text).
/changelog/rss.xml
  Content-Type: application/rss+xml; charset=utf-8
/changelog/atom.xml
  Content-Type: application/atom+xml; charset=utf-8
/md/*
  Content-Type: text/markdown; charset=utf-8
  X-Robots-Tag: noindex
/llms-full.txt
  Content-Type: text/markdown; charset=utf-8
