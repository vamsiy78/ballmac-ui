{
  "name": "ballmac-ui",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "dev": "turbo run dev --filter=@ballmac-ui/www",
    "build": "turbo run build",
    "build:registry": "tsx scripts/build-registry.ts",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "verify": "pnpm build:registry && pnpm check",
    "smoke": "tsx scripts/smoke-install.ts",
    "check": "tsx scripts/check-deps.ts && tsx scripts/check-licenses.ts && tsx scripts/validate-output.ts apps/www/public/r"
  },
  "devDependencies": {
    "turbo": "^2",
    "tsx": "^4",
    "typescript": "^5",
    "shadcn": "^4.21.0",
    "@ballmac-ui/metadata": "workspace:*"
  },
  "type": "module"
}
