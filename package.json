{
  "name": "ballmac-ui",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "dev": "turbo run dev --filter=@ballmac-ui/www",
    "build": "turbo run build",
    "pro:fetch": "tsx scripts/fetch-pro.ts",
    "starter:vendor": "tsx scripts/starter-vendor.ts",
    "starter:pack": "tsx scripts/starter-pack.ts",
    "verify:pro": "tsx scripts/verify-pro.ts",
    "launch:check": "tsx scripts/launch-check.ts",
    "build:registry": "tsx scripts/build-registry.ts",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "verify": "pnpm build:registry && pnpm check",
    "smoke": "tsx scripts/smoke-install.ts",
    "a11y": "tsx scripts/a11y.ts",
    "check": "tsx scripts/check-deps.ts && tsx scripts/check-licenses.ts && tsx scripts/rtl.ts && tsx scripts/i18n.ts && tsx scripts/media.ts && tsx scripts/validate-output.ts apps/www/public/r && shadcn registry validate registry.json",
    "test": "pnpm --filter @ballmac-ui/registry test && pnpm --filter @ballmac-ui/theme-engine test && pnpm --filter @ballmac-ui/www test",
    "rtl:sweep": "tsx scripts/rtl-sweep.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@ballmac-ui/metadata": "workspace:*",
    "playwright": "^1.63.0",
    "shadcn": "^4.21.0",
    "ts-morph": "^26.0.0",
    "tsx": "^4",
    "turbo": "^2",
    "typescript": "^5"
  },
  "type": "module"
}
