{
  "name": "ballmac-ui",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "dev": "turbo run dev --filter=@ballmac-ui/www",
    "build": "turbo run build",
    "pro:fetch": "tsx scripts/fetch-pro.ts",
    "starter:vendor": "tsx scripts/starter-vendor.ts",
    "starter:pack": "tsx scripts/starter-pack.ts",
    "figma:tokens": "tsx scripts/figma-tokens.ts",
    "figma:capture": "tsx scripts/figma-capture.ts",
    "link:crawl": "tsx scripts/link-crawl.ts",
    "seo:audit": "tsx scripts/seo-audit.ts",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "changeset:check": "tsx scripts/changeset-check.ts",
    "changelog": "tsx scripts/changelog.ts",
    "changelog:shots": "tsx scripts/changelog-shots.ts",
    "docs:links": "tsx scripts/docs-links.ts",
    "docs:generate": "tsx scripts/docs-reference.ts",
    "skill:generate": "tsx scripts/skill-generate.ts",
    "verified:generate": "tsx scripts/verified.ts",
    "lighthouse": "tsx scripts/lighthouse.ts",
    "indexnow": "tsx scripts/indexnow.ts",
    "reminders:schedule": "tsx scripts/schedule-reminders.ts",
    "pro:ci": "bash scripts/pro-ci.sh",
    "thumbs": "tsx scripts/thumbs.ts",
    "quality": "tsx scripts/quality.ts",
    "verify:pro": "tsx scripts/verify-pro.ts",
    "launch:check": "tsx scripts/launch-check.ts",
    "build:registry": "tsx scripts/build-registry.ts",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "verify": "pnpm build:registry && pnpm check",
    "smoke": "tsx scripts/smoke-install.ts",
    "a11y": "tsx scripts/a11y.ts",
    "a11y:states": "node scripts/a11y-states.mjs",
    "versions": "tsx scripts/versions.ts",
    "versions:write": "tsx scripts/versions.ts --write",
    "check": "tsx scripts/check-deps.ts && tsx scripts/check-base.ts && tsx scripts/check-client-boundary.ts && tsx scripts/check-motion.ts && tsx scripts/check-feel.ts && tsx scripts/check-states.ts && tsx scripts/versions.ts && tsx scripts/changelog.ts --check && tsx scripts/docs-reference.ts --check && tsx scripts/skill-generate.ts --check && tsx scripts/verified.ts --check && tsx scripts/check-licenses.ts && tsx scripts/rtl.ts && tsx scripts/i18n.ts && tsx scripts/media.ts && tsx scripts/validate-output.ts apps/www/public/r && shadcn registry validate registry.json",
    "test": "pnpm --filter @ballmac-ui/registry test && pnpm --filter @ballmac-ui/theme-engine test && pnpm --filter @ballmac-ui/audit test && pnpm --filter @ballmac/cli test && pnpm --filter @ballmac/mcp test && pnpm --filter @ballmac-ui/www test",
    "rtl:sweep": "tsx scripts/rtl-sweep.ts",
    "bump": "tsx scripts/bump.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@ballmac-ui/metadata": "workspace:*",
    "@ballmac-ui/theme-engine": "workspace:*",
    "@changesets/cli": "^3.0.3",
    "playwright": "^1.63.0",
    "shadcn": "^4.21.0",
    "ts-morph": "^26.0.0",
    "tsx": "^4",
    "turbo": "^2",
    "typescript": "^5"
  },
  "type": "module"
}
